# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Weather Data API (if using external sources)
# NEXT_PUBLIC_WEATHER_API_KEY=your_key_here

# Optional MapLibre style override (defaults to OpenFreeMap dark)
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# Optional radar tile template override (defaults to IEM NEXRAD base reflectivity)
# NEXT_PUBLIC_RADAR_TILE_URL=https://mesonet.agron.iastate.edu/cache/tile.py/1.0.0/nexrad-n0q-900913/{z}/{x}/{y}.png
