{
  "name": "barotropic",
  "version": "0.1.0",
  "private": true,
  "description": "Weather intelligence platform - examining evidence, recognizing patterns, forming hypotheses",
  "packageManager": "bun@latest",
  "type": "module",
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next dev",
    "start:prod": "bun --bun next start",
    "lint": "oxlint",
    "format": "oxcformatter --write .",
    "format:check": "oxcformatter --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:unit": "vitest --project unit",
    "test:integration": "vitest --project integration",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:docker": "docker compose -f docker-compose.test.yml up --abort-on-container-exit"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "next": "^14.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^2.2.0",
    "@vercel/analytics": "^1.4.0",
    "@vercel/speed-insights": "^2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.0",
    "happy-dom": "^15.0.0",
    "jsdom": "^30.1.2",
    "msw": "^2.1.5",
    "oxfmt": "^0.71.0",
    "oxlint": "^0.3.0",
    "playwright": "^1.45.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3"
  }
}
