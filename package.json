{
  "name": "barotropic",
  "version": "0.1.0",
  "private": true,
  "description": "Weather intelligence platform - examining evidence, recognizing patterns, forming hypotheses",
  "packageManager": "bun@latest",
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "oxlint",
    "format": "oxcformatter --write .",
    "format:check": "oxcformatter --check .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "next": "^14.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^2.2.0",
    "@vercel/analytics": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^0.3.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0"
  }
}
